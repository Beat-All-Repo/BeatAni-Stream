# BeatAni Stream Every where — Environment Variables
# Copy to .env and fill in your values

# ── BEATANI API (pre-configured, no changes needed) ─────────────────
VITE_BACKEND_ORIGIN=https://beat-anime-api-3.onrender.com
VITE_HIANIME_API_URL=https://beat-anime-api-3.onrender.com/api/v2/hianime
VITE_MANGA_API_URL=https://beat-anime-api-3.onrender.com/api/v2/manga
VITE_TATAKAI_API_URL=https://beat-anime-api-3.onrender.com/api/v2/anime
VITE_LOCAL_HIANIME_ORIGIN=https://beat-anime-api-3.onrender.com

# ── STREAMING PROXY (same API handles it) ───────────────────────────
VITE_PROXY_POOL_URLS=https://beat-anime-api-3.onrender.com/api/v1/streamingProxy
VITE_PROXY_NODE_URL=https://beat-anime-api-3.onrender.com/api/v1/streamingProxy
VITE_STREAM_PROXY_URL=https://beat-anime-api-3.onrender.com/api/v1/streamingProxy
VITE_STREAM_PROXY_PASSWORD=

# ── SUPABASE (get free project at https://supabase.com) ─────────────
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_ADMIN_API_SECRET=your_admin_secret_key

# ── OPTIONAL ─────────────────────────────────────────────────────────
VITE_MAL_CLIENT_ID=
VITE_ANILIST_CLIENT_ID=
VITE_GA_MEASUREMENT_ID=
